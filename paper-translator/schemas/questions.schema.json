{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "questions",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "block_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "context_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "packet": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          },
          "block_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "target_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "source_sha256",
                "target_sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "block_id",
          "question",
          "context_sha256",
          "packet",
          "created_at",
          "block_hashes"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "paper_id",
    "questions"
  ],
  "additionalProperties": false
}
