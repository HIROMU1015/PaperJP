{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "terminology-result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "const": "GPT"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "candidate_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "decision": {
            "enum": [
              "approve",
              "correct",
              "defer"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "suggestions": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "candidate_id",
          "candidate_sha256",
          "decision",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "paper_id",
    "reviewer",
    "packet_id",
    "results"
  ],
  "additionalProperties": false
}
